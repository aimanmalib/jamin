{
  "name": "jamin",
  "version": "0.1.0",
  "description": "Peer-to-peer trade escrow for BCH and CashTokens, written in SolidCash. A port of OpenPeerEscrow.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "solidhat:compile": "solidhat compile",
    "solidhat:typegen": "solidhat typegen",
    "solidhat:test": "solidhat test",
    "solidhat:clean": "solidhat clean",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
