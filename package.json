  },
  "dependencies": {
    "@bitauth/libauth": "3.0.0",
    "@electrum-cash/network": "4.4.8",
    "@solidcash/solidc": "0.51.1",
    "@solidcash/solidcash": "0.51.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@solidcash/solidhat": "0.51.1",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  }
}
