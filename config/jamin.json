{
  "site": {
    "url": "https://jamin.sasateguh.com",
    "defaultLanguage": "en",
    "languages": [
      "en",
      "ms"
    ]
  },
  "networks": {
    "default": "mock",
    "lifecycle": [
      "mock",
      "regtest",
      "mainnet"
    ]
  },
  "electrum": {
    "mainnet": {
      "hostname": "bch.imaginary.cash",
      "port": 50004,
      "scheme": "wss",
      "timeoutMs": 15000
    }
  },
  "explorer": {
    "mainnetTx": "https://blockchair.com/bitcoin-cash/transaction/{txid}",
    "mainnetAddress": "https://blockchair.com/bitcoin-cash/address/{address}"
  },
  "wallet": {
    "mnemonicEnv": "JAMIN_TEST_MNEMONIC",
    "envFile": ".env",
    "derivationBase": "m/44'/145'/0'/0",
    "roles": {
      "seller": 0,
      "buyer": 1,
      "arbitrator": 2,
      "feeRecipient": 3,
      "arbiterB": 4,
      "arbiterC": 5
    },
    "receiveIndex": 0
  },
  "mainnet": {
    "budgetSats": 2000000,
    "ledgerFile": "state/belanja.json",
    "fundingRequest": {
      "bchSats": 2000000,
      "pusd": "2.00"
    },
    "escrowAmountSats": 20000,
    "minFundingSats": 300000,
    "broadcastHosts": [
      "bch.imaginary.cash"
    ],
    "feeRateSatsPerByte": 1,
    "genesisCoinSats": 50000,
    "partyFloatSats": 40000,
    "tokenAmount": 100,
    "pendingFile": "state/mainnet/pending.json",
    "outputDir": "state/mainnet"
  },
  "tokens": {
    "pusd": {
      "symbol": "PUSD",
      "category": "2469acc5afa4b10cb5b5c04afb89c3a3ffd61c5da9c01e26d00951cae2a02544",
      "decimals": 2
    }
  },
  "escrow": {
    "feeBps": 30,
    "disputeFeeSats": 5000,
    "sellerWaitingTimeSeconds": 3600,
    "minSellerWaitingTimeSeconds": 900,
    "containerReserveSats": 1000
  },
  "banner": {
    "event": "BCH BLAZE 2026",
    "bounty": "Best SolidCash Application",
    "repoUrl": "https://github.com/aimanmalib/jamin",
    "prizeAddress": "bitcoincash:zplrydnf2z4pj4z9rv7uhmwsuxyrm8hj7uken87e7q",
    "deckUrl": "https://jamin.sasateguh.com/deck.pdf"
  },
  "mainnetExamples": "examples/mainnet.json",
  "regtest": {
    "image": "mainnet/bitcoin-cash-node:v29.0.0",
    "container": "jamin-regtest-bchn",
    "rpcPort": 18443,
    "cpus": 1,
    "upgrade12ActivationTime": 1690000000,
    "outputDir": "state/regtest",
    "partySats": 50000000,
    "genesisCoinSats": 100000,
    "tokenAmount": 200
  },
  "simulator": {
    "bchAmountSats": 20000,
    "tokenAmount": 200,
    "tokenSymbol": "TEST",
    "tokenDecimals": 2
  },
  "web": {
    "tabs": [
      "home",
      "try",
      "lifecycle",
      "contract"
    ],
    "contracts": [
      "JaminEscrow.scash",
      "JaminTokenEscrow.scash",
      "EscrowBase.scash",
      "FeeMath.scash"
    ],
    "languageStorageKey": "jamin.lang"
  },
  "deploy": {
    "contentSecurityPolicy": {
      "default-src": [
        "'self'"
      ],
      "script-src": [
        "'self'",
        "'wasm-unsafe-eval'"
      ],
      "style-src": [
        "'self'"
      ],
      "img-src": [
        "'self'",
        "data:"
      ],
      "font-src": [
        "'self'"
      ],
      "connect-src": [
        "'self'"
      ],
      "object-src": [
        "'none'"
      ],
      "base-uri": [
        "'none'"
      ],
      "form-action": [
        "'none'"
      ],
      "frame-ancestors": [
        "'none'"
      ]
    },
    "assetMaxAgeSeconds": 31536000
  },
  "walletSigning": {
    "roleKeyMessage": "Jamin role key\nSite: {site}\nRole: {role}\nTrade: {trade}"
  }
}
